# ---------------------------------------------------------------------------
# Database (MySQL)
# ---------------------------------------------------------------------------

# Passwords used by docker-compose's `db` service and the constructed
# DATABASE_URL. Generate with `openssl rand -hex 24`. Both required by
# docker-compose.yml. MYSQL_PASSWORD is the unprivileged app user;
# MYSQL_ROOT_PASSWORD is for admin tasks (mysqldump, manual SQL).
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme-root

# Explicit DATABASE_URL overrides the docker-compose default. Use when
# running the API outside compose (against a managed MySQL like 微信云托管
# MySQL, UCloud UDB MySQL, or TencentDB MySQL). Bare `mysql://` is fine —
# the app picks the aiomysql/pymysql driver at runtime.
# DATABASE_URL=mysql://talent_engine:pass@127.0.0.1:3306/talent_engine
# DATABASE_URL=mysql://talent_engine:pass@10.x.x.x:3306/talent_engine

# ---------------------------------------------------------------------------
# LLM provider — choose ONE and supply only its credentials.
# ---------------------------------------------------------------------------

# Which BAML client to route through. Must match a client name in
# api/v1/resume_matching/baml_src/main.baml. Unknown values fail loud at
# resolution time (ValueError on first request) — see llm_config.py.
#   Gemini    — original (Vertex AI primary, Google AI Studio fallback)
#   Qwen      — Aliyun DashScope OpenAI-compatible
#   Hunyuan   — Tencent OpenAI-compatible
#   DeepSeek  — text-only, low cost
LLM_PROVIDER=Gemini

# Gemini (only needed if LLM_PROVIDER=Gemini)
GOOGLE_CLOUD_PROJECT=
GEMINI_API_KEY=

# Qwen / DashScope (only needed if LLM_PROVIDER=Qwen)
QWEN_API_KEY=

# Hunyuan (only needed if LLM_PROVIDER=Hunyuan)
HUNYUAN_API_KEY=

# DeepSeek (only needed if LLM_PROVIDER=DeepSeek)
DEEPSEEK_API_KEY=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Listen port. Tencent CloudBase / Cloud Run / Aliyun FC inject this
# automatically; set explicitly for local docker-compose if needed.
PORT=8000

# CORS allowlist. Comma-separated. Default "*" is fine for dev.
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Rate limiting (per API key)
# ---------------------------------------------------------------------------

# Token-bucket per `api_key_id`. Process-local, resets on restart. Burst
# defaults to RATE_LIMIT_RPM. Set RATE_LIMIT_DISABLE=1 to bypass entirely
# (intended for tests + local debug).
# RATE_LIMIT_RPM=60
# RATE_LIMIT_BURST=60
# RATE_LIMIT_DISABLE=0

# ---------------------------------------------------------------------------
# LLM call hardening
# ---------------------------------------------------------------------------

# Per-attempt timeout for any BAML call (Parse* / ScoreMatch). One retry
# fires on TimeoutError / ConnectionError / HTTP 5xx-looking errors.
# LLM_CALL_TIMEOUT_SEC=30
# LLM_CALL_MAX_RETRIES=1

# ---------------------------------------------------------------------------
# e2a email notifications (one email per API call)
# ---------------------------------------------------------------------------

# Every authenticated /v1/* call emails a metadata-only summary via e2a.
# Leave E2A_API_KEY / E2A_AGENT_EMAIL / E2A_NOTIFY_TO unset to disable
# entirely — that's the default for local dev and CI.
#
# NOTE: /v1/resume-matching/match/{job_id} is a polling endpoint and
# partners are told to poll every 2s, so one async match emits roughly one
# email per poll. The send queue is bounded (E2A_NOTIFY_QUEUE_MAX) and
# sheds rather than growing; drops are logged, never silent.
#
# Bodies are metadata only — endpoint, key name, counts, latency, status.
# No résumé or JD content is ever sent. Keep it that way.

# E2A_API_KEY=e2a_agt_...
# E2A_AGENT_EMAIL=talent-engine@team.tokencanopy.com
# E2A_NOTIFY_TO=someone@example.com          # comma-separated for several
# E2A_NOTIFY_ENABLED=1                       # 0 to mute without dropping creds
# E2A_NOTIFY_QUEUE_MAX=1000
# E2A_NOTIFY_WORKERS=2
